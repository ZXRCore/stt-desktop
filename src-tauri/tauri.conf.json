{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "0xSTT",
  "version": "1.0.1",
  "identifier": "sh.zxr.0xstt",
  "build": {
    "frontendDist": "../frontend/desktop-build/.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "0xSTT",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' https://stt.zxr.sh http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["binaries/sidecar/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
